# ─────────────────────────────────────────────────────────────
# Configuração do SITE (catálogo público) — copie para ".env.site".
# É separada do .env da gestão: aqui não há nenhuma senha de fornecedor nem do Kommo.
# O arquivo .env.site NUNCA deve ser enviado ao Git.
# ─────────────────────────────────────────────────────────────

# Porta e host do site (o Nginx repassa catalogo.gestaoraizes.com.br para cá)
SITE_PORT=5100
SITE_HOST=127.0.0.1

# Banco do site (só a cópia pública dos produtos; pode ser apagado e sincronizado de novo)
SITE_DB_PATH=data/catalogo.db

# Endereço interno da gestão (mesmo servidor)
GESTAO_URL=http://127.0.0.1:5000

# O MESMO INTEGRACAO_TOKEN do .env da gestão (pelo menos 32 caracteres)
INTEGRACAO_TOKEN=

# Endereço público do site, sem barra no fim (links de compartilhamento e sitemap).
# Na troca para o domínio comercial, só esta linha muda (e o Nginx).
SITE_URL_PUBLICA=https://catalogo.gestaoraizes.com.br

# Intervalo da sincronização com a gestão, em minutos (o aviso da gestão adianta quando há novidade)
SINCRONIZACAO_MINUTOS=10

# 1 = liberar para o Google. Deixe 0 até o site ir ao ar (fase 3).
SITE_INDEXAR=0
