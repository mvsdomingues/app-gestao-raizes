# ─────────────────────────────────────────────────────────────
# Configuração da aplicação Raízes · Catálogo & Orçamento
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao Git.
# ─────────────────────────────────────────────────────────────

# Servidor
PORT=5000
HOST=127.0.0.1

# Caminhos (relativos à raiz do projeto)
DB_PATH=data/produtos.db
IMAGENS_DIR=data/imagens

# ── Asia Import (REST API paginada) ──
ASIA_API_KEY=
ASIA_SECRET_KEY=

# ── So Marcas (cabeçalho Authorization, já em Base64) ──
SM_AUTHORIZATION=

# ── Spot Gifts (download de CSV) ──
SPOT_ACCESS_KEY=

# ── Minha XBZ (REST API) ──
XBZ_CNPJ=
XBZ_TOKEN=
