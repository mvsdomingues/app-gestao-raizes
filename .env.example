# ─────────────────────────────────────────────────────────────
# Configuração da aplicação Raízes · Catálogo & Orçamento
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao Git.
# ─────────────────────────────────────────────────────────────

# Servidor
PORT=5000
HOST=127.0.0.1

# Endereço público do sistema, usado nos links de orçamento enviados aos clientes
# (ex.: https://orcamentos.raizespersonalizados.com.br ou http://203.0.113.10).
# Vazio = o endereço pelo qual a tela foi aberta (IP, domínio ou localhost).
APP_URL_PUBLICA=

# Caminhos (relativos à raiz do projeto)
DB_PATH=data/produtos.db
IMAGENS_DIR=data/imagens

# ── Asia Import (REST API paginada) ──
ASIA_API_KEY=
ASIA_SECRET_KEY=

# ── So Marcas (cabeçalho Authorization, já em Base64) ──
SM_AUTHORIZATION=

# ── Spot Gifts (download de CSV) ──
SPOT_ACCESS_KEY=

# ── Minha XBZ (REST API) ──
XBZ_CNPJ=
XBZ_TOKEN=

# ── Kommo (CRM: clientes dos orçamentos) ──
# Sem subdomínio e token a integração fica desligada (orçamentos sem cliente).
# Subdomínio da conta: o que vem antes de ".kommo.com" no endereço do Kommo.
KOMMO_SUBDOMINIO=
# Token de longa duração (Kommo → Configurações → Integrações → sua integração privada → Chaves e escopos)
KOMMO_TOKEN=
# Intervalo da sincronização incremental dos contatos (minutos)
KOMMO_SYNC_MINUTOS=10
# Só para testes com um Kommo simulado:
# KOMMO_BASE_URL=http://127.0.0.1:5099
